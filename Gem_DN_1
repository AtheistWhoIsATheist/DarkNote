  const [newPromptText, setNewPromptText] = useState('');

  const [newPromptTags, setNewPromptTags] = useState('');

  const [editingPromptId, setEditingPromptId] = useState(null);

  const [editPromptTitle, setEditPromptTitle] = useState('');

  const [editPromptText, setEditPromptText] = useState('');

  const [editPromptTags, setEditPromptTags] = useState('');

  const [searchTerm, setSearchTerm] = useState('');

  const [loading, setLoading] = useState(true);

  const [error, setError] = useState(null);

  const [message, setMessage] = useState(''); // For user messages (e.g., success/error)

  

  // State for LLM operations

  const [llmStates, setLlmStates] = useState({}); // Stores loading/results for each prompt's LLM ops

  const [isGeneratingTags, setIsGeneratingTags] = useState(false);

  const [generatedTagsError, setGeneratedTagsError] = useState(null);

  

  // Firebase Initialization and Authentication

  useEffect(() => {

    try {

      // MANDATORY: Use __app_id and __firebase_config from the environment

      const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

      const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};

  

      if (Object.keys(firebaseConfig).length === 0) {

        console.error("Firebase config is not defined. Please ensure __firebase_config is set.");

        setError("Firebase configuration missing. Cannot connect to database.");

        setLoading(false);

        return;

      }

  

      const app = initializeApp(firebaseConfig);

      const firestore = getFirestore(app);

      const firebaseAuth = getAuth(app);

  

      setDb(firestore);

      setAuth(firebaseAuth);

  

      // Listen for auth state changes

      const unsubscribe = onAuthStateChanged(firebaseAuth, async (user) => {

        if (user) {

          setUserId(user.uid);

          setIsAuthReady(true);

        } else {

          // If no user, try to sign in anonymously

          try {

            if (typeof __initial_auth_token !== 'undefined') {

              await signInWithCustomToken(firebaseAuth, __initial_auth_token);

            } else {

              await signInAnonymously(firebaseAuth);

            }

          } catch (authError) {

            console.error("Firebase authentication error:", authError);

            setError(`Authentication failed: ${authError.message}`);

            setLoading(false);

          }

        }

      });

  

      // Cleanup subscription on unmount

      return () => unsubscribe();

    } catch (e) {

      console.error("Error initializing Firebase:", e);

      setError(`Failed to initialize Firebase: ${e.message}`);

      setLoading(false);

    }

