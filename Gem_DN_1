    const unsubscribe = onSnapshot(promptsCollectionRef, (snapshot) => {

      const fetchedPrompts = snapshot.docs.map(doc => ({

        id: doc.id,

        ...doc.data()

      }));

      // Sort prompts by creation date, assuming a 'createdAt' field or by ID

      fetchedPrompts.sort((a, b) => (b.createdAt?.toDate() || b.id).toString().localeCompare((a.createdAt?.toDate() || a.id).toString()));

      setPrompts(fetchedPrompts);

      setLoading(false);

