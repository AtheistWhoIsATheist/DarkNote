          result.candidates[0].content && result.candidates[0].content.parts &&

          result.candidates[0].content.parts.length > 0) {

        const text = result.candidates[0].content.parts[0].text;

        setLlmStates(prev => ({ ...prev, [promptId]: { ...prev[promptId], psychomorphologicalAnalysis: text, isAnalyzingPsychomorphology: false } }));

      } else {

        const errorMessage = result.error?.message || 'Unexpected API response structure.';

        setLlmStates(prev => ({ ...prev, [promptId]: { ...prev[promptId], llmError: `Psychomorphological analysis failed: ${errorMessage}`, isAnalyzingPsychomorphology: false } }));

        console.error("Gemini API error (psychomorphological analysis):", result);

      }

    } catch (e) {

      setLlmStates(prev => ({ ...prev, [promptId]: { ...prev[promptId], llmError: `Network error during psychomorphological analysis: ${e.message}`, isAnalyzingPsychomorphology: false } }));

      console.error("Fetch error (psychomorphological analysis):", e);

    }

  };

  

  // Function to clear LLM results for a specific prompt

  const clearLlmResult = (promptId, type) => {

    setLlmStates(prev => {

      const newState = { ...prev };

      if (newState[promptId]) {

        if (type === 'summary' || type === 'all') newState[promptId].summary = null;

        if (type === 'expansion' || type === 'all') newState[promptId].expansion = null;

        if (type === 'counterThesis' || type === 'all') newState[promptId].counterThesis = null;

        if (type === 'refinedPrompt' || type === 'all') newState[promptId].refinedPrompt = null;

        if (type === 'paradoxStack' || type === 'all') newState[promptId].paradoxStack = null;

        if (type === 'psychomorphologicalAnalysis' || type === 'all') newState[promptId].psychomorphologicalAnalysis = null;

        if (type === 'error' || type === 'all') newState[promptId].llmError = null;

      }

      return newState;

    });

  };

  

  // Function to use LLM output as a new prompt

  const handleUseAsNewPrompt = (text) => {

    setNewPromptText(text);

    setNewPromptTitle(''); // Clear title to encourage new title

    setNewPromptTags(''); // Clear tags to encourage new tags or generation

    showMessage('LLM output copied to new prompt input!', 'info');

    // Optionally scroll to the add new prompt section

    window.scrollTo({ top: 0, behavior: 'smooth' });

  };

  

  // Function to append LLM output to the original prompt

  const handleAppendPrompt = async (promptId, textToAppend) => {

    if (!db || !userId) {

      showMessage('Database not ready or user not authenticated.', 'error');

      return;

    }

  

    try {

      const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

      const promptDocRef = doc(db, `artifacts/${appId}/users/${userId}/prompts`, promptId);

      const docSnap = await getDoc(promptDocRef);

  

      if (docSnap.exists()) {

        const currentText = docSnap.data().text;

        // Ensure there's a clear separation if the current text isn't empty

        const separator = currentText.trim() === "" ? "" : "\n\n";

        const updatedText = currentText + separator + textToAppend;

        await updateDoc(promptDocRef, { text: updatedText });

        showMessage('LLM output appended to prompt successfully!', 'success');

        // Clear the specific LLM output that was appended, but keep others if any

        // This requires knowing which type of output was appended. For simplicity, clear all.

        clearLlmResult(promptId, 'all');

      } else {

        showMessage('Prompt not found.', 'error');

      }

    } catch (e) {

      console.error("Error appending to prompt: ", e);

      showMessage(`Failed to append to prompt: ${e.message}`, 'error');

    }

  };

  

  // Function to copy the entire prompt text to clipboard

  const handleCopyPromptText = (promptText) => { // Renamed to avoid conflict

    handleCopyToClipboard(promptText, 'Prompt');

  };

  
  

  // Filtered prompts based on search term (case-insensitive)

  const filteredPrompts = prompts.filter(prompt =>

    prompt.title.toLowerCase().includes(searchTerm.toLowerCase()) ||

    prompt.text.toLowerCase().includes(searchTerm.toLowerCase()) ||

    prompt.tags.some(tag => tag.toLowerCase().includes(searchTerm.toLowerCase()))

  );

  

