import React, { useState, useEffect, useCallback } from 'react';

import { initializeApp } from 'firebase/app';

import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';

import { getFirestore, collection, addDoc, getDocs, onSnapshot, doc, updateDoc, deleteDoc, query, where, getDoc } from 'firebase/firestore';

// Import marked for Markdown parsing

import { marked } from 'marked';

  
  

// Ensure Tailwind CSS is available in the environment.

// This component assumes Tailwind CSS is globally linked or configured.

  

// Main App Component

